# Copy to .dev.vars for Wrangler. Never use VITE_ prefixes for secrets.
ALLOW_PAID_MODELS=false
MAX_LIVE_SAMPLE=20
ANTHROPIC_API_KEY=
# Set an available model ID from GET https://api.anthropic.com/v1/models
CLAUDE_MODEL=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
OPEN_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional USD per million tokens, manually checked for the configured model.
CLAUDE_INPUT_USD_PER_MILLION=
CLAUDE_OUTPUT_USD_PER_MILLION=
OPEN_INPUT_USD_PER_MILLION=
OPEN_OUTPUT_USD_PER_MILLION=
