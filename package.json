{
  "name": "campaignproof-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src web tests",
    "build": "vite build && wrangler deploy --dry-run --outdir dist-worker",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply campaignproof --local",
    "db:seed": "wrangler d1 execute campaignproof --local --file artifacts/seed.sql",
    "test:api": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "dev:restricted": "node --require ./scripts/loopback-fallback.cjs node_modules/wrangler/wrangler-dist/cli.js dev --ip 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.4",
    "wrangler": "4.152.0"
  }
}
