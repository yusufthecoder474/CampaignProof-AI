{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"campaignproof-ai","main":"src/index.ts","compatibility_date":"2026-10-23",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"campaignproof","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "workflows":[{"name":"campaignproof-run","binding":"RUN_WORKFLOW","class_name":"PredictionWorkflow"}],
  "vars":{"ALLOW_PAID_MODELS":"false","MAX_LIVE_SAMPLE":"20","OPEN_MODEL":"@cf/meta/llama-3.3-70b-instruct-fp8-fast"}
}
